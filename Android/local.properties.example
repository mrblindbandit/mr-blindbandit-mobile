## Copy to Android/local.properties (gitignored). Do not commit secrets.
sdk.dir=/Users/YOU/Library/Android/sdk

# Client-safe keys only:
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
LIVEKIT_URL=wss://REPLACE_ME.livekit.cloud
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# LiveKit room tokens are minted by the authenticated Blindbandit API at runtime.
# NEVER put CLERK_SECRET_KEY, LIVEKIT_API_SECRET, LIVEKIT_API_KEY, or GOOGLE_OAUTH_CLIENT_SECRET here for shipping builds.
