# Mr. Blindbandit Mobile — required configuration keys
# Copy values into gitignored local files. NEVER commit secrets.

## Clerk (https://clerk.com)
# Publishable key is safe for the client binary.
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
# Secret key stays on the server only. Do not put in the app.
# CLERK_SECRET_KEY=sk_live_xxxxxxxx

## LiveKit (https://livekit.io)
# WebSocket URL is safe for the client.
LIVEKIT_URL=wss://your-project.livekit.cloud
# API key + secret stay on the server. Mobile receives short-lived room tokens.
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxx
# Optional local-only scaffolding token (gitignored):
# LIVEKIT_TOKEN=eyJ...

## Google OAuth (optional social sign-in)
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# Client secret stays on the server / Clerk dashboard.
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxx

## iOS local file
# Create App/Secrets.local.swift from App/Secrets.local.swift.example

## Android local file
# Create Android/local.properties from Android/local.properties.example
# Or set CLERK_PUBLISHABLE_KEY / LIVEKIT_URL in local.properties
