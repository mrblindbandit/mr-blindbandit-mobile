default_platform(:ios)
platform :ios do
  desc "Create/fetch distribution signing via App Store Connect API key, archive, upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"), in_house: false)
    setup_ci
    cert(api_key: api_key, team_id: ENV.fetch("APPLE_TEAM_ID"), keychain_path: ENV.fetch("KEYCHAIN_PATH"), keychain_password: "")
    sigh(api_key: api_key, force: true, app_identifier: "net.mrblindbandit.app", team_id: ENV.fetch("APPLE_TEAM_ID"))
    update_code_signing_settings(path: "Blindbandit.xcodeproj", use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"), code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME], targets: ["Blindbandit"])
    build_app(project: "Blindbandit.xcodeproj", scheme: "Blindbandit", configuration: "Release",
      export_method: "app-store", xcargs: "CODE_SIGNING_ALLOWED=YES",
      export_options: { provisioningProfiles: { "net.mrblindbandit.app" => lane_context[SharedValues::SIGH_NAME] } })
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
