require "base64"
require "tmpdir"
default_platform(:ios)
platform :ios do
  desc "Create/fetch distribution signing via App Store Connect API key, archive, upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"), in_house: false)
    create_keychain(name: "ci_signing", password: "ci_signing", default_keychain: true, unlock: true, timeout: 3600, lock_when_sleeps: false)
    keychain_path = File.expand_path("~/Library/Keychains/ci_signing-db")
    # Persistent distribution certificate (V5XTA6JX5P) stored as repo secrets, so CI never mints new ones.
    p12 = File.join(Dir.tmpdir, "dist.p12")
    File.binwrite(p12, Base64.decode64(ENV.fetch("IOS_DIST_P12_BASE64")))
    import_certificate(certificate_path: p12, certificate_password: ENV.fetch("IOS_DIST_P12_PASSWORD"),
      keychain_path: keychain_path, keychain_password: "ci_signing")
    File.delete(p12)
    # One App Store profile per signed *embedded* target. Widgets (net.mrblindbandit.app.widgets) and
    # Watch (net.mrblindbandit.app.watchkitapp) stay out of the archive until ASC App IDs + profiles exist;
    # then add them here and re-embed in project.yml.
    targets = { "Blindbandit" => "net.mrblindbandit.app",
                "ScreenShare" => "net.mrblindbandit.app.ScreenShare",
                "NotificationService" => "net.mrblindbandit.app.NotificationService" }
    profiles = {}
    targets.each do |target, ident|
      sigh(api_key: api_key, force: true, app_identifier: ident, team_id: ENV.fetch("APPLE_TEAM_ID"))
      profiles[ident] = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(path: "Blindbandit.xcodeproj", use_automatic_signing: false,
        team_id: ENV.fetch("APPLE_TEAM_ID"), code_sign_identity: "Apple Distribution",
        profile_name: profiles[ident], targets: [target])
    end
    build_app(project: "Blindbandit.xcodeproj", scheme: "Blindbandit", configuration: "Release",
      export_method: "app-store", xcargs: "CODE_SIGNING_ALLOWED=YES",
      export_options: { provisioningProfiles: profiles })
    # Truly skip waiting: do NOT pass changelog with skip_waiting — pilot still waits for the build to
    # appear just to attach notes, and ASC Invalid Binary means it never appears (CI hits job timeout).
    # Set What to Test in ASC after the build is Ready to Test.
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true,
      distribute_external: false)
  end
end
